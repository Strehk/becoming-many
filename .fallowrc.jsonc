// Purpose: Enforce confirmed ownership boundaries and intentional export conventions.
// Context: The refactor keeps one runtime and isolates concrete content modules.
// Responsibility: Detect forbidden imports without suppressing inherited violations.
// Boundary: Import rules do not prove lifecycle, behavior, or performance correctness.
{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "ignoreExports": [
    {
      "file": "src/levels/*.level.ts",
      "exports": ["level"]
    }
  ],
  "boundaries": {
    "zones": [
      // Specific data files precede the broader startup/composition owner.
      {
        "name": "presets",
        "patterns": ["src/levels/*.level.ts"]
      },
      {
        "name": "level-contracts",
        "patterns": ["src/levels/level-preset.ts"]
      },
      { "name": "level-routes", "patterns": ["src/levels/level-names.ts"] },
      { "name": "levels", "patterns": ["src/levels/**"] },
      // Shared contracts/mechanics are not concrete child modules.
      { "name": "modules", "autoDiscover": ["src/modules"] },
      { "name": "module-contracts", "patterns": ["src/modules/*.ts"] },
      { "name": "world", "patterns": ["src/world/**"] },
      { "name": "world-surface", "patterns": ["src/world-surface/**"] },
      { "name": "control", "patterns": ["src/control/**"] },
      { "name": "m5-protocol", "patterns": ["src/m5/protocol.ts"] },
      { "name": "m5", "patterns": ["src/m5/**"] },
      { "name": "utils", "patterns": ["src/utils/**"] },
      {
        "name": "show-queries",
        "patterns": [
          "src/dramaturgy/narration-catalog.ts",
          "src/dramaturgy/narration-schedule.ts",
          "src/dramaturgy/schedule-layout.ts"
        ]
      },
      { "name": "dramaturgy", "patterns": ["src/dramaturgy/**"] },
      { "name": "sound", "patterns": ["src/sound/**"] },
      { "name": "deployment", "patterns": ["src/station/**"] },
      { "name": "station-backend", "patterns": ["station/**"] },
      { "name": "benchmark", "patterns": ["src/benchmark/**"] },
      { "name": "app-styles", "patterns": ["src/app.css"] },
      {
        "name": "entries",
        "patterns": ["src/*.entry.ts"]
      },
      {
        "name": "test-entry-tools",
        "patterns": ["src/test-ui/test-level-modules.ts"]
      },
      { "name": "flash", "patterns": ["src/flash/**"] },
      {
        "name": "ui",
        "patterns": [
          "src/conductor/**",
          "src/dev/**",
          "src/ui/**",
          "src/test-ui/**"
        ]
      }
    ],
    "rules": [
      { "from": "presets", "allow": [], "allowTypeOnly": ["level-contracts"] },
      {
        "from": "level-contracts",
        "allow": [],
        "allowTypeOnly": ["modules", "module-contracts"]
      },
      {
        "from": "modules",
        "allow": [
          "module-contracts",
          "world",
          "world-surface",
          "utils",
          "dramaturgy",
          "show-queries"
        ]
      },
      {
        "from": "module-contracts",
        "allow": ["world", "world-surface", "utils"]
      },
      { "from": "world", "allow": ["utils"] },
      { "from": "world-surface", "allow": [] },
      { "from": "control", "allow": ["m5", "world", "world-surface", "utils"] },
      { "from": "m5", "allow": ["m5-protocol", "utils"] },
      { "from": "m5-protocol", "allow": [] },
      { "from": "utils", "allow": [] },
      { "from": "show-queries", "allow": [] },
      { "from": "dramaturgy", "allow": ["show-queries", "utils"] },
      { "from": "sound", "allow": ["dramaturgy", "show-queries", "utils"] },
      { "from": "deployment", "allow": ["utils"] },
      { "from": "level-routes", "allow": [] },
      {
        "from": "station-backend",
        "allow": ["deployment", "level-routes", "m5-protocol"]
      },
      { "from": "flash", "allow": ["m5-protocol"] },
      {
        "from": "ui",
        "allow": ["show-queries"],
        "allowTypeOnly": ["levels", "world", "m5", "m5-protocol", "deployment"]
      },
      {
        "from": "test-entry-tools",
        "allow": ["modules/zone-visualizer"],
        "allowTypeOnly": ["levels", "level-contracts"]
      },
      {
        "from": "benchmark",
        "allow": ["world"]
      },
      {
        "from": "entries",
        "allow": [
          "ui",
          "flash",
          "test-entry-tools",
          "benchmark",
          "deployment",
          "app-styles",
          "presets",
          "level-contracts",
          "level-routes",
          "levels",
          "dramaturgy",
          "show-queries"
        ]
      },
      {
        "from": "levels",
        "allow": [
          "presets",
          "level-contracts",
          "level-routes",
          "modules",
          "module-contracts",
          "world",
          "world-surface",
          "control",
          "m5",
          "utils",
          "dramaturgy",
          "show-queries",
          "sound"
        ],
        // Existing in-page route contract; no benchmark execution imports.
        "allowTypeOnly": ["benchmark"]
      }
    ]
  }
}
