# Purpose: Name every per-station value docker-compose.yml reads.
# Context: Copy to `.env` beside docker-compose.yml and fill in per station.
# Responsibility: Document each variable; every one is optional.
# Boundary: These are network identity for one deployment. Authored tunables
#   stay in the typed settings files under src/ and never move here.

# Host port the station publishes. 80 keeps the pages at http://localhost/
# and http://localhost/conductor.html, which the deployment direction calls
# for (secure context, no mixed-content blocking).
HOST_PORT=80

# Address of this station's M5 tilt controller: hostname, host:port, or full
# origin (e.g. bm-station-a-m5.local or 192.168.1.50). Set, the show polls it
# from startup and the conductor's "M5 host" field turns read-only. Empty,
# the operator sets the host in the conductor UI as before.
M5_HOST=

# DeviceId every M5 payload must carry (e.g. bm-a-m5). Set, a neighbour
# station's controller triggers an operator-visible warning and never steers.
# Empty, any device is accepted.
M5_DEVICE_ID=

# Label shown on the conductor page so a technician can tell the identical
# stations apart (e.g. "Station A").
STATION_NAME=

# Host port of the simulated M5, only used with `docker compose --profile sim`.
# Point the station at it with M5_HOST=localhost:5183.
SIM_PORT=5183
